# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Production / hosted database (Neon, Render Postgres, etc.)
DATABASE_URL=postgresql://username:password@hostname:5432/database_name?sslmode=require

# Local development database — used by npm run migrate, npm run seed:dev, npm test
LOCAL_DATABASE_URL=postgresql://localhost:5432/pulsecare_dev

# Local test database — used only by npm test
TEST_DATABASE_URL=postgresql://localhost:5432/pulsecare_test

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Auth ──────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
SESSION_SECRET=replace-with-a-long-random-secret

# ── URLs ──────────────────────────────────────────────────────────────────────
# Local dev: http://localhost:8000
# Production: your public URL (also accepted as RENDER_EXTERNAL_URL)
BASE_URL=http://localhost:8000

# ── SMTP Reminders (optional — disable by leaving these unset) ────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=notifications@example.com

# ── Feature flags ────────────────────────────────────────────────────────────
# Set to 'false' to disable the in-process SMTP reminder scheduler
ENABLE_REMINDERS=false
